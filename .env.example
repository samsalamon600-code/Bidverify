# Application Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=replace-with-strong-application-secret-key
JWT_SECRET_KEY=replace-with-strong-jwt-secret-key-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# Database Configuration (PostgreSQL primary; falls back to local SQLite if Postgres server is unreachable in demo mode)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gem_compliance_db
ALLOW_SQLITE_FALLBACK=true

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=25
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,doc,docx

# OCR & NLP Settings
PRIMARY_OCR_ENGINE=paddleocr
FALLBACK_OCR_ENGINE=easyocr
SPACY_MODEL=en_core_web_sm

# Compliance Scoring Weights (Must sum to 1.0)
WEIGHT_DOCUMENT_COMPLIANCE=0.25
WEIGHT_STATUTORY_COMPLIANCE=0.25
WEIGHT_TECHNICAL_COMPLIANCE=0.30
WEIGHT_TENDER_COMPLIANCE=0.20

# External Integration Mode (MOCK for SIH Demo; set to LIVE when authorized API credentials are provided)
INTEGRATION_MODE=MOCK
GSTN_API_KEY=
UDYAM_API_KEY=
MCA21_API_KEY=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
EPFO_API_KEY=
ESIC_API_KEY=
